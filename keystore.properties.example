# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to
# the repo root. Back up the keystore and passwords somewhere safe: with Play
# App Signing this is your *upload* key, which Google can reset if lost, but
# only after identity checks that take days.
storeFile=../tahsin-upload.jks
storePassword=
keyAlias=upload
keyPassword=
