<?xml version="1.0" encoding="utf-8"?>
<!-- Only included paths are copied; models and recordings stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="tahsin_user.db" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="tahsin_user.db" />
    </device-transfer>
</data-extraction-rules>
